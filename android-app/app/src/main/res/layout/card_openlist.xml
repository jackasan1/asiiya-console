<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/olCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_green">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud"
                        app:tint="@color/ico_fg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ol_title"
                        android:textColor="@color/fg"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOlSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ol_sub_init"
                        android:textColor="@color/dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOlState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="@string/state_loading"
                    android:textColor="@color/dim"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btnOlMore"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/ol_more"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_more"
                    app:tint="@color/dim" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_block"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ol_card_port"
                        android:textColor="@color/dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvOlPortValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ol_dash"
                        android:textColor="@color/fg"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_block"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ol_card_uptime"
                        android:textColor="@color/dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvOlUptimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ol_dash"
                        android:textColor="@color/fg"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_block"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ol_card_boot"
                        android:textColor="@color/dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvOlBootValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ol_dash"
                        android:textColor="@color/fg"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <TextView
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:id="@+id/btnOlStart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h"
                    android:layout_weight="1"
                    android:text="@string/act_start" />

                <TextView
                    android:background="@drawable/bg_btn_danger"
                    android:gravity="center"
                    android:textColor="@color/bad"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:id="@+id/btnOlStop"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/act_stop" />

                <TextView
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:textColor="@color/fg"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:id="@+id/btnOlOpen"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/act_ol_open" />
            </LinearLayout>

        </LinearLayout>
