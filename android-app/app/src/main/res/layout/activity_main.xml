<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/fg"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/dim"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSvc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:gravity="end"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/card"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/accent"
        android:textIsSelectable="false"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints=""
        android:hint="@string/api_key_hint"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword"
        android:maxLines="1"
        android:textColor="@color/fg"
        android:textColorHint="@color/dim"
        android:textSize="13sp" />

    <LinearLayout style="@style/Row">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreflight"
            style="@style/Btn"
            android:text="@string/act_preflight" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Btn"
            android:text="@string/act_refresh" />
    </LinearLayout>

    <LinearLayout style="@style/Row">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstall"
            style="@style/Btn"
            android:text="@string/act_install" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/Btn"
            android:text="@string/act_open" />
    </LinearLayout>

    <LinearLayout style="@style/Row">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Btn"
            android:text="@string/act_start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Btn"
            android:text="@string/act_stop" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/label_log"
        android:textColor="@color/dim"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@color/card"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/logfg"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>

    <TextView
        android:id="@+id/labelInstall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_install_out"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/svInstall"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="4dp"
        android:background="@color/card"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/logfg"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>
</LinearLayout>
