<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <gradient
                android:angle="270"
                android:startColor="@color/card_hi"
                android:endColor="@color/card_lo" />
            <corners android:radius="@dimen/ico_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/stroke_w" android:color="@color/stroke" />
            <corners android:radius="@dimen/ico_radius" />
        </shape>
    </item>
</layer-list>
