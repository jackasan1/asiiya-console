<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen Soft: 卡内指标块 = 次级面 + 微渐变 + 描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <corners android:radius="@dimen/block_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/card_hi"
                android:endColor="@color/card_lo"
                android:type="linear" />
            <corners android:radius="@dimen/block_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/stroke_w" android:color="@color/stroke" />
            <corners android:radius="@dimen/block_radius" />
        </shape>
    </item>
</layer-list>
